{
  "name": "winter-arc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Winter Arc - a 90-day discipline, fitness, study, nutrition and sleep transformation system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --force --noEmit",
    "test:domain": "node qa/run-domain.mjs",
    "test:journey": "node qa/journey.mjs",
    "test:edge": "node qa/edge.mjs",
    "test:visual": "node qa/visual.mjs",
    "test": "npm run typecheck && npm run test:domain",
    "qa": "npm run build && npm run test:domain && npm run test:journey && npm run test:edge"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "esbuild": "^0.25.0"
  }
}
